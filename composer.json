{
  "name": "huanghantao/loro-php",
  "description": "PHP bindings for Loro CRDT via UniFFI.",
  "type": "composer-plugin",
  "license": "MIT",
  "extra": {
    "class": "Loro\\Composer\\NativeLibraryPlugin"
  },
  "autoload": {
    "psr-4": {
      "Loro\\Composer\\": "src/Composer/"
    },
    "files": [
      "src/LoroFFI.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Loro\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "build-ffi": "scripts/build_php_ffi.sh",
    "cs-fix": "php-cs-fixer fix --sequential",
    "test": "@php -d ffi.enable=1 vendor/bin/phpunit"
  },
  "require": {
    "php": ">=8.1",
    "composer-plugin-api": "^2.2",
    "ext-ffi": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5",
    "friendsofphp/php-cs-fixer": "^3"
  }
}
